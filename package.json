{
  "name": "garam-fps",
  "version": "0.1.0",
  "private": true,
  "description": "GARAM: ZERO HOUR - Competitive 5v5 Tactical FPS",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm --workspace=@garam/client run dev",
    "dev:server": "npm --workspace=@garam/server run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@gradio/client": "^2.8.0",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.10",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
